# Local guidance for Claude Code, not part of tracked content.
CLAUDE.md

# Real secrets — never committed.
.env

# Python
__pycache__/
*.pyc
.venv/

# Java / Maven / Gradle
target/
.gradle/
build/

# Ballerina
.ballerina/
verification/*/Dependencies.toml
# demo/*/Dependencies.toml is NOT ignored, same reasoning as
# orchestrator/Dependencies.toml above: combining ballerina/a2a's gRPC
# binding with a resolvable-but-incompatible newer ballerina/http hits the
# same real ABI-coupling issue (ballerina-platform/ballerina-library#2496)
# on a truly from-scratch dependency resolution — reproduced directly
# while building demo/concurrent_tasks. Pin and commit it; always build
# and run demo/ packages with --sticky.
# orchestrator/Dependencies.toml is NOT ignored: combining ballerina/ai
# with ballerina/a2a's gRPC binding hits a real upstream grpc/http-native
# ABI-coupling issue (ballerina-platform/ballerina-library#2496) unless
# the resolved graph is pinned and committed — same pattern a2a-ballerina
# itself uses for its own Ballerina.toml/Dependencies.toml. Always build
# and run this package with --sticky.

# WSO2 Integrator: BI writes these into a package on first Run/Debug —
# per BI's own generated .gitignore, "This should not be committed to
# version control": Config.toml can carry dev-time secrets, and
# trace_enabled.bal just toggles local tracing. .vscode/ is BI's launch
# config for the same, equally local to whoever's debugging.
Config.toml
trace_enabled.bal
.vscode/

# connections.bal is intentionally tracked (not ignored): it's just the
# ai:Wso2ModelProvider wiring BI generates, and committing it means a
# fresh checkout works with BI without regenerating it. It still must
# never reach the orchestrator's Docker build — that deployment uses
# ANTHROPIC_API_KEY directly instead, and if this file leaks into the
# build context (orchestrator/.dockerignore excludes it for that reason)
# the container crashes on startup with "ballerina.ai.wso2ProviderConfig
# is not configured correctly".

# macOS
.DS_Store

# scripts/start-all.sh runtime state
/logs/
/.pids/

# scripts/watch-agents-local.sh / watch-agents-docker.sh runtime state —
# generated per-agent runner scripts, regenerated on every run. The
# local variant bakes ANTHROPIC_API_KEY into these files, so this must
# never be committed.
/.watch-agents/

# Docker build staging — populated fresh from the local Ballerina
# repository by orchestrator/prepare-docker-build.sh before each image
# build, never committed (it's a copy of a2a-ballerina's own build
# output, not this repo's).
orchestrator/.docker-local-repo/
