# Copy this file to .env (git-ignored) and fill in a real key.
# scripts/start-all.sh sources .env automatically if present.

ANTHROPIC_API_KEY=

# Optional — both already default to a demo value if left unset. Read on
# BOTH sides: the agent itself (application.properties / auth.py) checks
# the request against this value, and the orchestrator (agent_tools.bal)
# reads the same var to know what to present, so client and server always
# agree without either hardcoding the other's value. Rotate a token by
# changing it here and restarting both sides — nothing else to edit.
# PAYROLL_ADMIN_TOKEN=demo-payroll-admin-secret
# PEOPLEOPS_STAFF_TOKEN=demo-staff-secret

# Optional — all default to ~200 (3 staged steps ~= 10 real minutes) for
# a genuine long-running onboarding/offboarding/hardware-provisioning task.
# Only takes effect on the *next* time scripts/start-agents.sh (or
# start-all.sh) starts that specific agent — restart it to change the pace.
# ONBOARDING_STEP_DELAY_SECONDS=200
# OFFBOARDING_STEP_DELAY_SECONDS=200
# HARDWARE_PROVISIONING_STEP_DELAY_SECONDS=200
# PAYROLL_REVIEW_STEP_DELAY_SECONDS=200
# TRAVELEXPENSE_REVIEW_STEP_DELAY_SECONDS=200
